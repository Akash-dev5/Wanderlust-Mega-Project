@Library ("shared") _
pipeline {

    agent { label "max" }

    stages {

        stage("Hello") {
            steps {
                hello() echo "CSM added"
            }
        }

        stage("Code Clone") {
            steps {
                clone("https://github.com/Akash-dev5/Wanderlust-Mega-Project.git","main")
                    echo "Cloning completed"
            }
        }

        stage('Build Docker Images') {
            steps {
                dockerBuild()
            }
        }

        stage('Push Docker Images') {
            steps {
                pushDockerHub( "djandocicd-backend","djandocicd-frontend")
            }
        }

        stage('Deploy') {
            steps {
                deploy()
            }
        }
    }
}
